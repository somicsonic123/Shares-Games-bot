# Discord bot credentials
# Copy this file to .env, then replace every placeholder value.
# Never commit .env or share your bot token.

# Bot token from Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token_here

# Application ID from Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=your_discord_application_client_id_here

# Server ID where slash commands should be registered
GUILD_ID=your_discord_server_guild_id_here

# Your Discord user ID (enable Developer Mode, then Copy User ID)
OWNER_ID=your_discord_user_id_here
